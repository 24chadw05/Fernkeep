; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fernkeep"
run/main_scene="uid://b7sgppxeo2hqn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=30
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://scripts/core/SignalBus.gd"
EconomyManager="*uid://bgw01j816sub2"
ProgressionManager="*uid://j4ctjfigs3f5"
DataManager="*res://scripts/managers/DataManager.gd"
BuildingManager="*res://scripts/managers/BuildingManager.gd"
CitizenManager="*res://scripts/managers/CitizenManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
ResourceManager="*res://scripts/managers/ResourceManager.gd"
MarketManager="*res://scripts/managers/MarketManager.gd"
RoadManager="*res://scripts/managers/RoadManager.gd"
TimeManager="*res://scripts/managers/TimeManager.gd"
ReputationManager="*res://scripts/managers/ReputationManager.gd"
QuestManager="*res://scripts/managers/QuestManager.gd"
RecipeManager="*res://scripts/managers/RecipeManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor]

version_control/autoload_on_startup=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
