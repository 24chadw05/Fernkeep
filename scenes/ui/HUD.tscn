[connection signal="pressed" from="Panel/VBox/BuildButton" to="." method="_on_build_button_pressed"]
[connection signal="pressed" from="Panel/VBox/CitizensButton" to="." method="_on_citizens_button_pressed"]
[connection signal="pressed" from="Panel/VBox/QuestsButton" to="." method="_on_quests_button_pressed"]
[connection signal="pressed" from="Panel/VBox/SaveButton" to="." method="_on_save_button_pressed"]
[connection signal="pressed" from="Panel/VBox/CancelRoadButton" to="." method="_on_cancel_road_pressed"]
