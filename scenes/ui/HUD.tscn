size_flags_horizontal = 3

[node name="Separator" type="HSeparator" parent="Panel/VBox"]

[node name="BuildButton" type="Button" parent="Panel/VBox"]
text = "Build"
custom_minimum_size = Vector2(0, 36)

[node name="CitizensButton" type="Button" parent="Panel/VBox"]
text = "Citizens"
custom_minimum_size = Vector2(0, 36)

[node name="QuestsButton" type="Button" parent="Panel/VBox"]
text = "Quests"
custom_minimum_size = Vector2(0, 36)

[node name="SaveButton" type="Button" parent="Panel/VBox"]
text = "Save"
