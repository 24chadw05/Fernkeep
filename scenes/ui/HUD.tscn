[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/HUD.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Panel" type="Panel" parent="."]
offset_left = 8.0
offset_top = 8.0
offset_right = 220.0
offset_bottom = 420.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
offset_left = 12.0
offset_top = 12.0
offset_right = 208.0
offset_bottom = 408.0

[node name="GoldLabel" type="Label" parent="Panel/VBox"]
text = "Gold: 0"
theme_override_font_sizes/font_size = 14

[node name="LevelLabel" type="Label" parent="Panel/VBox"]
text = "Level 1 (0/100 XP)"
theme_override_font_sizes/font_size = 12

[node name="HappinessLabel" type="Label" parent="Panel/VBox"]
text = "Happiness: 100%"
theme_override_font_sizes/font_size = 12

[node name="CitizensLabel" type="Label" parent="Panel/VBox"]
text = "Citizens: 0"
theme_override_font_sizes/font_size = 12

[node name="TimeLabel" type="Label" parent="Panel/VBox"]
text = "Day 1  •  Spring  •  Year 1"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.75, 0.85, 1.0, 1.0)

[node name="Resources" type="HBoxContainer" parent="Panel/VBox"]

[node name="WoodLabel" type="Label" parent="Panel/VBox/Resources"]
text = "Wood: 50"
theme_override_font_sizes/font_size = 11
size_flags_horizontal = 3

[node name="StoneLabel" type="Label" parent="Panel/VBox/Resources"]
text = "Stone: 30"
